# Copy this file to .env in the repository root and fill in your Kotak Neo API details.
# Do not commit the filled-in .env file.
KOTAK_CONSUMER_KEY=your_consumer_key_here
KOTAK_MOBILE=+91xxxxxxxxxx
KOTAK_UCC=your_ucc_here
KOTAK_ENVIRONMENT=prod

# Enter a fresh TOTP and your MPIN in the app login form; do not store them here.

# Optional INDstocks market-data-only connection for the paper backend.
# Generate in https://www.indstocks.com/app/api-trading/access-tokens
# Never commit a real token. Restart the paper backend after changing it.
INDSTOCKS_ACCESS_TOKEN=
